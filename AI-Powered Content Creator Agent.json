{
  "name": "AI-Powered Content Creator Agent",
  "nodes": [
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert B2B technology content\nstrategist and professional LinkedIn content\nwriter.\n\nYour responsibility is to create high-quality,\ninformative, insightful and engaging LinkedIn\nposts based on the research provided.\n\nOBJECTIVE:\nGenerate professional LinkedIn content that\nattracts technology professionals, business\nleaders, IT decision-makers and enterprise\nexecutives.\n\nCONTENT GUIDELINES:\n\n1. Start with a powerful and engaging hook\n   that captures the reader's attention.\n\n2. Explain the topic in a simple but technically\n   accurate manner.\n\n3. Include important facts, findings and\n   industry insights from the supplied research.\n\n4. Highlight real-world enterprise applications\n   and business value wherever supported\n   by the research.\n\n5. Use short paragraphs and bullet points\n   where appropriate.\n\n6. Maintain a professional, conversational\n   and thought-provoking tone.\n\n7. Avoid unnecessary technical jargon.\n\n8. Never invent statistics, quotations,\n   examples or factual claims.\n\n9. Do not present unsupported predictions\n   as established facts.\n\n10. End with an engaging question that\n    encourages professional discussion.\n\n11. Include 3-5 relevant hashtags.\n\nLENGTH REQUIREMENT:\nThe LinkedIn post must contain 150-250 words.\n\nQUALITY REQUIREMENTS:\n- Ensure logical flow and readability.\n- Avoid repetitive statements.\n- Use the supplied research as the factual\n  foundation.\n- Do not copy entire sentences from sources.\n- Do not include fabricated citations.\n\nOUTPUT FORMAT:\nReturn only the final LinkedIn post.\nDo not include explanations, introductory\ncomments or descriptions of your process."
            },
            {
              "content": "={{ `Create a professional LinkedIn post on the following topic.\n\nTOPIC:\n${$json.Topic}\n\nRESEARCH INFORMATION:\n${$json.Research_Context}\n\nUse the supplied research as your factual foundation.\n\nIdentify the most important and interesting insights relevant to enterprise technology.\n\nMake the content useful for technology professionals, business leaders and enterprise decision-makers.\n\nEnsure the final post follows all the instructions provided in the System message.` }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        -528,
        -320
      ],
      "id": "8a275047-2046-4b6b-bad7-2ec2fe9590c3",
