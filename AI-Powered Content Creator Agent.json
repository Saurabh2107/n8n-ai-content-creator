    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert social media content creator\nspecializing in X (formerly Twitter).\n\nYour responsibility is to create concise,\nengaging and informative posts about technology.\n\nFollow these instructions:\n\n1. Write in a crisp and engaging style.\n2. Start with an attention-grabbing statement.\n3. Communicate the most important insight.\n4. Avoid unnecessary explanations.\n5. Use simple and accessible language.\n6. Maintain technical accuracy.\n7. Never invent facts, statistics or claims.\n8. Include relevant hashtags where appropriate.\n9. Encourage engagement naturally.\n\nLENGTH REQUIREMENT:\nThe final post must not exceed 280 characters,\nincluding spaces and hashtags.\n\nQUALITY REQUIREMENTS:\n- Focus on one key insight.\n- Avoid repetitive statements.\n- Use research-supported information.\n- Avoid excessive hashtags.\n- Do not use unsupported statistics.\n\nOUTPUT FORMAT:\nReturn only the final X post.\nDo not include explanations or commentary."
            },
            {
              "content": "=Create an engaging X post about the following\ntopic.\n\nTOPIC:\n{{ $json.Topic }}\n\nRESEARCH INFORMATION:\n{{ $json.Research_Context }}\n\nIdentify the most interesting insight and\ncommunicate it in a concise and engaging manner.\n\nThe content should be relevant to technology\nprofessionals and business leaders.\n\nEnsure the final response is within 280 characters."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
